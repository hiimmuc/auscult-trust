# environments
.venv/
.venv-train/
# caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
# run artefacts (see src/runs.py): small outputs and weights stay out of git, keep the READMEs
outputs/
checkpoints/*
!checkpoints/README.md
logs/
*.log
# data lives in ../data (or $AT_DATA); only the README is tracked
data/*
!data/README.md
!data/.gitkeep
# local
.env
.DS_Store
