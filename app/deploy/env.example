# API process environment (export before starting uvicorn)
AT_APP_BUNDLE=app/bundle
AT_APP_AUTH=auto                              # on | off | auto: auto enforces the token when AT_APP_TOKEN is set; on refuses to start without one; off leaves the API open
AT_APP_TOKEN=change-me-long-random-string     # e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
AT_APP_RATE_LIMIT=0                           # inference requests per minute, all clients together; 0 = unlimited
AT_APP_SAMPLES=on                             # on | off: off serves no demo samples (the ICBHI recordings) and disables Demo mode
AT_APP_ORIGINS=https://auscult-trust.pages.dev  # the web app origin(s), comma-separated
# Web build
VITE_API_BASE=https://api.example.org
