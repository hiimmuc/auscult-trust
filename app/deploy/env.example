# API process environment (export before starting uvicorn)
AT_APP_BUNDLE=app/bundle
AT_APP_TOKEN=change-me-long-random-string     # e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
AT_APP_ORIGINS=https://auscult-trust.pages.dev  # the web app origin(s), comma-separated
# Web build
VITE_API_BASE=https://api.example.org
